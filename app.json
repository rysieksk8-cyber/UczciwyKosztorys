{
  "expo": {
    "name": "Kosztorys Mechanika",
    "slug": "onspace-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/logo.png",
    "scheme": "onspaceapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "extra": {
      "voiceInputMode": "keyboard"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCalendarsUsageDescription": "Kosztorys Mechanika otwiera formularz wizyty, której zapis zatwierdzasz samodzielnie.",
        "NSCalendarsWriteOnlyAccessUsageDescription": "Pozwól dodać wizytę po zatwierdzeniu w formularzu kalendarza."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#F4F7F2"
      },
      "edgeToEdgeEnabled": true,
      "permissions": ["android.permission.RECORD_AUDIO"],
      "blockedPermissions": ["android.permission.READ_CALENDAR", "android.permission.WRITE_CALENDAR"]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "./plugins/withSpeechCompatibility",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F7F2"
        }
      ],
      "expo-web-browser",
      [
        "expo-av",
        {
          "microphonePermission": "Pozwól aplikacji Kosztorys Mechanika nagrywać opis pracy do rozpoznania polskiej mowy."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
